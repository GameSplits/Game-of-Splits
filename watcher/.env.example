# watcher/.env.example: on Vercel these are the project's environment variables (see README). Holds no private key.
RPC_URL=               # Robinhood Chain RPC (secret: may contain an API key)
ARCHIVE_RPC_URL=       # RPC that serves eth_call at past blocks (fill check); defaults to RPC_URL
CHAIN_ID=              # 4663 mainnet, 46630 testnet
CORE=                  # FairCore, from deployments/<chainId>.json
ARROW=                 # LastArrow
SEAT=                  # SheriffsSeat
ALMS=                  # AlmsVote
PASS=                  # FairPass
VAULT=                 # LocksleyVault
KEEPER=                # the expected keeper address (update on a planned rotation)
START_BLOCK=           # L2 block from deployments/<chainId>.json
NONCE_START=           # the keeper's nonce at go-live (0 for a fresh key)
GO_LIVE_AT=            # unix time of DRY_RUN=0 (heartbeat before the first swap)
HEALTHCHECK_URL=       # required dead-man switch (healthchecks.io ping URL, period 2 min, grace 10 min)
CRON_SECRET=           # secret: Vercel cron bearer token
SENDLOG_SECRET=        # secret: HMAC key for the send log, same value as the keeper's
OIDC_REPOSITORY=       # owner/repo of the keeper's own repo (send-log entries must carry its OIDC token)
OIDC_WORKFLOW=         # optional (default .github/workflows/keeper.yml)
OIDC_REF=              # optional (default refs/heads/main)
OIDC_AUDIENCE=         # optional (default gos-watcher)
OIDC_REQUIRED=         # tests only: 0 turns the OIDC check off
UPSTASH_REDIS_REST_URL=   # Upstash Redis REST URL (eviction OFF)
UPSTASH_REDIS_REST_TOKEN= # secret: Upstash REST token
PUSHOVER_TOKEN=        # secret: Pushover app token (required unless ALERT_FILE)
PUSHOVER_GROUP=        # secret: Pushover delivery group
PRICE_MODE=            # optional: v4quoter or testroute
MAINTENANCE_UNTIL=     # optional unix time: owner events before it come as one digest
CONFIRMATIONS=         # optional (default 5): events read up to head minus this
GAP_ALERT_BPS=         # optional (default 1000)
FILL_ALERT_BPS=        # optional (default 200)
FILL_AVG_ALERT_BPS=    # optional (default 200)
FILL_SIZE_ALLOW_BPS=   # optional (default 100 per 250 USDG)
ETH_DROP_MAX_WEI_PER_HOUR= # optional (default 1e15)
HEARTBEAT_S=           # optional (default 10800)
MAX_BLOCK_RANGE=       # optional (default 200000 per pass)
# tests / local runner only (bin/local.mjs): STATE_FILE, ALERT_FILE, PORT, HC_FILE
