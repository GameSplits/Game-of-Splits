# e2e/.env.example: the fork test needs no secrets. keeper_watcher.sh sets everything else itself (throwaway key,
# local Safe, local watcher) and refuses to run against anything that isn't a local anvil node.
FOUNDRY_BIN=           # optional: folder with forge/anvil/cast (Foundry 1.5.x)
PORT=                  # optional anvil port (default 8571)
E2E_PORT=              # optional local watcher port (default 8790)
E2E_DEBUG=             # optional: 1 prints the front-run sizing
