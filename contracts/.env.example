# contracts/.env.example: settings the Foundry scripts and tests read. Copy to .env (never committed) only for local use.
# Deploy keys are NEVER put here. Mainnet and testnet both use a Foundry encrypted keystore.
#   cast wallet import gos-mainnet --interactive          (mainnet; testnet uses a separate gos-testnet keystore)
#   forge script ... --broadcast --account gos-mainnet --sender <addr>
# The keystore password is typed at the prompt only. Never --password, --password-file, --unsafe-password,
# CAST_UNSAFE_PASSWORD, or shell history.
# The mainnet deployer is a fresh single-use EOA. It holds only gas ETH, is never a Safe signer, and never holds
# USDG or $wif. After the Safe accepts, SafeAcceptVerify checks it has no power left. Then sweep leftover gas ETH
# to the Safe and delete the keystore (~/.foundry/keystores/gos-mainnet). See RUNBOOK_KEEPER.md.
# Testnet deploy is a different fresh single-use EOA (gos-testnet). It is not a Safe owner.
# Signer 1 (0xb44F…50bA) stays a Safe owner. SafeAcceptVerify's no-leftover-power check applies on testnet too.

# ---- DeployMainnet (script/Deploy.s.sol) ----
DEPLOYER=              # the fresh deployer EOA (the --account / --sender address). An address, not a key.
OWNER_SAFE=            # the multisig Safe that owns the game; must equal PINNED_MAINNET_SAFE in script/Deploy.s.sol
SAFE_OWNERS=           # that Safe's 3 owner addresses, comma-separated (the deploy checks they match exactly)
ALMS_SAFE=             # optional; the Alms Safe IS the owner Safe, so leave blank or set it equal to OWNER_SAFE
KEEPER=                # the keeper's address (gas-only key; the key itself lives only in the keeper repo's Environment)
TOLL_RECIPIENT=        # where the Toll is withdrawn to
ANCHOR_SEED=           # 30-min average of `forge script script/Mainnet.s.sol:QuoteAnchor` (buy-token wei per USDG unit, x1e18)
ELIGIBLE_IDS=          # required on mainnet: comma-separated donate.gg configIds, see eligible/fair0.json
# ALMS_MIN_NOTICE=3600  # testnet only, seconds (default 86400; mainnet is always 24h). Uncomment to set: an empty value fails to parse
# ALMS_MIN_WINDOW=7200  # testnet only, seconds (default 86400; mainnet is always 24h). Uncomment to set: an empty value fails to parse

# ---- QuoteAnchor (script/Mainnet.s.sol): defaults to the launch token's pool; for another ETH/token v4 pool set all four
POOL_TOKEN=
POOL_FEE=
POOL_TICK_SPACING=
POOL_HOOK=

# ---- SafeAcceptVerify / ResumeHandover (script/SafeAccept.s.sol, script/Deploy.s.sol) ----
# SafeAcceptBatch is obsolete: the deploy hands ownership to the Safe (A1-14) and the batch script reverts.
# SafeAcceptVerify is read-only (no --account). It needs GOS_SAFE (or OWNER_SAFE), DEPLOYER, KEEPER, TOLL_RECIPIENT,
# ANCHOR_SEED, FAIR_START, FAIR_END, ELIGIBLE_IDS and the ALMS_* windows, all equal to what the deploy used.
ELIGIBLE_COUNT=        # number of charity ids set at deploy (default 0)
# ResumeHandover only, after a stopped broadcast: GAME_CONFIG FAIR_PASS FAIR_CORE ALMS_VOTE LOCKSLEY_VAULT ROBIN RAKE_BUYER
DEPLOYMENT_FILE=       # optional: path to deployments/<chainId>.json (default picks by chain)

# ---- DeployTestnet ----
TESTNET_OWNER=         # the testnet Safe for the rehearsal; must equal PINNED_TESTNET_SAFE (uses SAFE_OWNERS too)
# DEPLOYER on testnet is the gos-testnet address, not signer 1 and not gos-mainnet.
FAIR_START=            # optional unix start of the test Fair (default now + 120 s)
FAIR_END=              # optional unix end (default start + 7 days)
SEAT_DAY_SECONDS=      # optional Seat day length (default 86400; e.g. 600 for a compressed Fair)
ALMS_SUGGEST=          # optional Alms windows (unix); all three or none
ALMS_VOTE=
ALMS_END=
CONFIG_DELAY=          # optional GameConfig delay in seconds on testnet (default 0; mainnet is fixed at 7 days)
TOKEN_B_RATE=          # optional TestRoute rate for the second test token, tTKB per USDG unit (default 100e12)

# ---- tests ----
FORK_BLOCK=            # optional: pin fork tests to a block (default latest)
SIM_RPC=               # Fair 0 sim only: the local anvil node made by script/e2e/fair0_sim.sh
SIM_DEPLOYMENT=        # Fair 0 sim only: that node's deployments/4663.json

# --- DeployFeeSplitter (BLK-5, live at launch, right after the deploy and before Verify) ---
# GOS_SAFE and SAFE_OWNERS as above. Mainnet needs nothing else. Its split is fixed to option b, 0,5000,0,4000,1000
# (purses, vault, rebate, burn, ops), and its four holder legs are the Safe, so leave these empty or set them to the Safe.
# The vault leg is the deploy's Locksley Vault. On 46630 the four are required (an EOA or the Safe, never the deployer)
# and FEE_SPLIT_BPS="purses,vault,rebate,burn,ops" may override the split for both the deploy and Verify.
PURSES=
REBATE=
BURN_BUYER=
OPS=
# FEE_SPLIT_BPS=0,5000,0,4000,1000   (46630 only, refused on mainnet)
