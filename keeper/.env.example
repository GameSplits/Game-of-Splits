# keeper/.env.example: on GitHub these are Environment `keeper` secrets/vars (see README). Locally, for dry runs only.
RPC_URL=               # Robinhood Chain RPC (secret: may contain an API key)
CHAIN_ID=              # 4663 mainnet, 46630 testnet
CORE=                  # FairCore address, from deployments/<chainId>.json
ARROW=                 # LastArrow address
SEAT=                  # SheriffsSeat address
ALMS=                  # AlmsVote address
PRICE_MODE=            # optional: v4quoter (mainnet default) or testroute (testnet default)
DRY_RUN=               # anything but 0 is a dry run; 0 for a live run
KEEPER_ADDRESS=        # the keeper's address (enough for a dry run)
KEEPER_KEY=            # secret, live runs only, GitHub Environment secret ONLY; never in a file
WATCHER_URL=           # the watcher's base URL (send log + price samples)
SENDLOG_SECRET=        # secret: HMAC key for the send log, same value as the watcher's
PUSHOVER_TOKEN=        # secret: Pushover app token (required unless ALERT_FILE)
PUSHOVER_GROUP=        # secret: alert delivery group
ALERT_FILE=            # tests only: write alerts to this JSONL file instead of Pushover
MAX_FEE_GWEI=          # optional fee ceiling (blank = 1 gwei)
START_DELAY_MAX_S=     # optional random start delay (default 600)
OIDC_AUDIENCE=         # optional OIDC audience (default gos-watcher; must match the watcher)
ALLOW_OTHER_CHAIN=     # tests only: 1 allows a chain id other than 4663/46630
# ACTIONS_ID_TOKEN_REQUEST_URL / ACTIONS_ID_TOKEN_REQUEST_TOKEN are set by GitHub Actions itself (id-token: write)
